# The website (Next.js). Copy to .env.local and fill in. Real values never
# go to GitHub; on Vercel they're set in Project → Settings → Environment
# Variables.

# Where the API runs. The site proxies /api/* here (next.config.ts), so the
# browser only ever talks to the site's own domain.
# Local: http://localhost:5000   Production: https://theshutterbug.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Shared secret with the API (same value as PROXY_KEY in backend/.env and on
# Render). src/proxy.ts uses it to pass on the visitor's address for the
# API's rate limits. Optional for local development.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PROXY_KEY=
